PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# AIDEN's LLM brain — OpenRouter (https://openrouter.ai)
# 1. Sign up at https://openrouter.ai and create a key: https://openrouter.ai/keys
# 2. Paste it below
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any model slug from https://openrouter.ai/models works here, e.g.:
#   anthropic/claude-sonnet-4.5
#   openai/gpt-4o-mini
#   google/gemini-2.5-flash
#   meta-llama/llama-3.3-70b-instruct
#   deepseek/deepseek-chat
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Used only in the OpenRouter "HTTP-Referer" header (attribution/rate limits) — set to your real domain in production
SITE_URL=http://localhost:5173
